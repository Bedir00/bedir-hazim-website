{% doc %}
Renders an editable Home Gym training tile.
@param {object} block - Training tile block
@param {string} prefix - Unique identifier for the current shelf
{% enddoc %}
<article class="hg-card" data-card data-category="{{ block.settings.destination }}" data-card-id="{{ block.id }}" data-search="{{ block.settings.card_title | escape }} {{ block.settings.question | escape }} {{ block.settings.tag | escape }}" {{ block.shopify_attributes }}>
<a class="hg-poster" href="{{ routes.root_url }}?view={{ block.settings.destination }}&amp;preview_theme_id={{ theme.id }}" aria-labelledby="{{ prefix }}-{{ block.id }}">
{% if block.settings.image != blank %}
{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 1200px) 24vw, (min-width: 750px) 38vw, 72vw', class: 'hg-card-image' }}
{% else %}<img class="hg-card-image" src="{{ block.settings.asset | asset_url }}" width="800" height="533" loading="lazy" alt="">{% endif %}
<span class="hg-card-brand" aria-hidden="true">HG<span>.</span></span>
<div class="hg-poster-title"><span class="hg-tag">{{ block.settings.tag | escape }}</span><h3 id="{{ prefix }}-{{ block.id }}">{{ block.settings.card_title | default: block.settings.question | escape }}</h3><span class="hg-poster-cta">{{ 'home_gym.stream.more' | t }} <span aria-hidden="true">↗</span></span></div>
</a><div class="hg-card-bottom"><p>{{ block.settings.answer | escape }}</p></div>
</article>