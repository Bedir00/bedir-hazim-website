{% doc %}
Renders the "Schau es dir selbst an" section of a Home Gym landing page: the 360° tour,
which loads Google Maps only after a click (assets/hg-tour-inline.js), and, when set,
the portrait training video next to it.
@param {object} section - Home Gym section
@param {string} src - Google Maps embed URL of the tour
{% enddoc %}
<style>.hg-tour-section{padding-block:72px 64px;scroll-margin-top:28px}.hg-tour-section-head{max-width:760px;margin-bottom:32px}.hg-tour-section-head h2{font-size:clamp(32px,3.3vw,48px);line-height:1.05;text-transform:uppercase;font-weight:900;font-stretch:125%;letter-spacing:-.03em}.hg-tour-section-head p:last-child{margin-top:16px;font-size:16px;line-height:1.6;color:var(--muted)}.hg-tour-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:20px;align-items:start}.hg-tour-grid--video{grid-template-columns:minmax(0,1fr) clamp(220px,24vw,340px)}.hg-tour-embed{position:relative;aspect-ratio:16/10;border-radius:8px;overflow:hidden;background:#171719;border:1px solid #2f2f33;isolation:isolate}.hg-tour-embed img{position:absolute;inset:0;z-index:-2;width:100%;height:100%;object-fit:cover;filter:brightness(.55)}.hg-tour-embed:after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(60% 60% at 50% 50%,rgba(5,5,6,.2),rgba(5,5,6,.75))}.hg-tour-embed[data-loaded]:after{display:none}.hg-tour-embed iframe{display:block;width:100%;height:100%;border:0}.hg-tour-start{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center}.hg-tour-start-icon{display:grid;place-items:center;width:88px;height:88px;border-radius:50%;background:var(--accent);color:#050506;transition:transform .2s}.hg-tour-start-icon svg{width:40px;height:40px}.hg-tour-start:hover .hg-tour-start-icon,.hg-tour-start:focus-visible .hg-tour-start-icon{transform:scale(1.06)}.hg-tour-start-label{font-size:18px;font-weight:900;font-stretch:125%;text-transform:uppercase;letter-spacing:-.01em}.hg-tour-note{margin-top:12px;font-size:12px;line-height:1.5;color:#95958f}.hg-tour-video{margin:0}.hg-tour-video video{display:block;width:100%;aspect-ratio:9/16;object-fit:cover;border-radius:8px;background:#171719;border:1px solid #2f2f33}.hg-tour-video figcaption{margin-top:10px;font-size:13px;font-weight:700;color:#d3d3cd}@media(max-width:749px){.hg-tour-section{padding-block:48px 40px}.hg-tour-section-head{margin-bottom:22px}.hg-tour-section-head h2{font-size:30px}.hg-tour-section-head p:last-child{font-size:14px}.hg-tour-grid--video{grid-template-columns:minmax(0,1fr)}.hg-tour-embed{aspect-ratio:4/5}.hg-tour-start-icon{width:72px;height:72px}.hg-tour-start-icon svg{width:34px;height:34px}.hg-tour-start-label{font-size:15px}.hg-tour-video{width:min(100%,360px)}}@media(prefers-reduced-motion:reduce){.hg-tour-start-icon{transition:none}}</style>
{%- liquid
  assign has_video = false
  if section.settings.preview_mp4_url != blank or section.settings.video != blank
    assign has_video = true
  endif
-%}
<section id="rundgang" class="hg-tour-section hg-shell" aria-labelledby="hg-tour-heading-{{ section.id }}">
<div class="hg-tour-section-head">{% if section.settings.tour_label != blank %}<p class="hg-kicker">{{ section.settings.tour_label | escape }}</p>{% endif %}<h2 id="hg-tour-heading-{{ section.id }}">{{ section.settings.tour_section_title | escape }}<span class="hg-accent">.</span></h2>{% if section.settings.tour_section_text != blank %}<p>{{ section.settings.tour_section_text | escape }}</p>{% endif %}</div>
<div class="hg-tour-grid{% if has_video %} hg-tour-grid--video{% endif %}">
<div><div class="hg-tour-embed" data-tour-embed data-tour-title="{{ section.settings.tour_section_title | escape }}">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 1000, 1600', sizes: '(min-width: 750px) 66vw, 100vw', alt: '' }}{% else %}<img src="{{ section.settings.hero_asset | asset_url }}" width="1200" height="800" loading="lazy" alt="">{% endif %}<a class="hg-tour-start" href="{{ src | escape }}" target="_blank" rel="noopener" data-tour-start><span class="hg-tour-start-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.5 10.2c.3.6.5 1.2.5 1.8 0 2.5-4 4.5-9 4.5s-9-2-9-4.5 4-4.5 9-4.5c1.5 0 2.9.2 4.1.5"/><path d="m14.6 6.1 2 1.9-2.4 1.4"/><circle cx="12" cy="12" r="1.4"/></svg></span><span class="hg-tour-start-label">{{ section.settings.tour_start_label | escape }}</span></a></div>
{% if section.settings.tour_note != blank %}<p class="hg-tour-note">{{ section.settings.tour_note | escape }}</p>{% endif %}</div>
{% if has_video %}<figure id="vorschau" class="hg-tour-video">{% if section.settings.preview_mp4_url != blank %}<video controls playsinline preload="metadata" width="416" height="740"><source src="{{ section.settings.preview_mp4_url | escape }}#t=0.5" type="video/mp4"></video>{% else %}{{ section.settings.video | video_tag: controls: true, preload: 'none', image_size: '800x' }}{% endif %}<figcaption>{{ 'home_gym.stream.video_title' | t }}</figcaption></figure>{% endif %}
</div>
</section>
<script src="{{ 'hg-tour-inline.js' | asset_url }}" defer></script>
