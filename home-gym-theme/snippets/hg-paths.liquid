{% doc %}
Renders the audience buttons in the Home Gym hero, each with a 360° tour link below it.
@param {object} section - Home Gym section
{% enddoc %}
<style>.hg-paths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-width:1040px;margin-bottom:22px}.hg-path-item{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-width:0}.hg-path{display:flex;flex-direction:column;justify-content:center;gap:6px;flex:1;align-self:stretch;min-height:78px;padding:14px 18px;border:1px solid #ffffff3d;border-radius:4px;background:rgba(5,5,6,.55);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);transition:border-color .18s,background .18s}.hg-path:hover,.hg-path:focus-visible{border-color:var(--accent);background:rgba(5,5,6,.78)}.hg-path-title{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:16px;line-height:1.15;font-weight:900;font-stretch:125%;letter-spacing:-.01em;text-transform:uppercase}.hg-path-title>span{color:var(--accent)}.hg-path-sub{font-size:12px;line-height:1.4;color:#c9c9c3}.hg-path-tour{display:inline-flex;align-items:center;gap:7px;min-height:36px;padding:4px 2px;font-size:11px;line-height:1.2;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#e5e5df;transition:color .18s}.hg-path-tour svg{width:18px;height:18px;color:var(--accent)}.hg-path-tour:hover{color:var(--accent)}@media(max-width:989px){.hg-paths{grid-template-columns:repeat(2,minmax(0,1fr));max-width:640px}}@media(max-width:749px){.hg-paths{gap:8px;margin-bottom:14px}.hg-path{min-height:66px;padding:10px 12px;gap:4px}.hg-path-title{font-size:13px;font-stretch:100%}.hg-path-sub{font-size:10px}.hg-path-tour{min-height:32px;font-size:10px;letter-spacing:.06em;gap:6px}.hg-path-tour svg{width:16px;height:16px}.hg-stream[data-mode=home] .hg-billboard{height:auto}}@media(prefers-reduced-motion:reduce){.hg-path,.hg-path-tour{transition:none}}</style>
{%- capture entrance_src %}{% render 'hg-tour-src', value: section.settings.tour_entrance %}{% endcapture -%}
<nav class="hg-paths" aria-label="{{ 'home_gym.stream.browse' | t }}">{% for i in (1..4) %}{% capture label_key %}path_{{ i }}_label{% endcapture %}{% capture sub_key %}path_{{ i }}_sub{% endcapture %}{% capture view_key %}path_{{ i }}_view{% endcapture %}{% capture tour_key %}path_{{ i }}_tour{% endcapture %}{% assign label = section.settings[label_key] %}{% if label != blank %}{% capture tour_src %}{% render 'hg-tour-src', value: section.settings[tour_key] %}{% endcapture %}{% if tour_src == blank %}{% assign tour_src = entrance_src %}{% endif %}<div class="hg-path-item"><a class="hg-path" href="{{ routes.root_url }}?view={{ section.settings[view_key] }}&amp;preview_theme_id={{ theme.id }}"><span class="hg-path-title">{{ label | escape }} <span aria-hidden="true">↗</span></span>{% if section.settings[sub_key] != blank %}<span class="hg-path-sub">{{ section.settings[sub_key] | escape }}</span>{% endif %}</a>{% if tour_src != blank and section.settings.tour_label != blank %}<a class="hg-path-tour" href="{{ tour_src | escape }}" target="_blank" rel="noopener" data-tour-open data-tour-title="{{ label | escape }} · {{ section.settings.tour_label | escape }}" aria-label="{{ label | escape }}: {{ section.settings.tour_label | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 10.2c.3.6.5 1.2.5 1.8 0 2.5-4 4.5-9 4.5s-9-2-9-4.5 4-4.5 9-4.5c1.5 0 2.9.2 4.1.5"/><path d="m14.6 6.1 2 1.9-2.4 1.4"/><circle cx="12" cy="12" r="1.4"/></svg>{{ section.settings.tour_label | escape }}</a>{% endif %}</div>{% endif %}{% endfor %}</nav>
