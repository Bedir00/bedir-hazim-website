{% doc %}
Renders the audience buttons in the Home Gym hero.
@param {object} section - Home Gym section
{% enddoc %}
<style>.hg-paths{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;max-width:1040px;margin-bottom:22px}.hg-path{display:flex;flex-direction:column;justify-content:center;gap:6px;min-height:78px;padding:14px 18px;border:1px solid #ffffff3d;border-radius:4px;background:rgba(5,5,6,.55);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);transition:border-color .18s,background .18s}.hg-path:hover,.hg-path:focus-visible{border-color:var(--accent);background:rgba(5,5,6,.78)}.hg-path-title{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:16px;line-height:1.15;font-weight:900;font-stretch:125%;letter-spacing:-.01em;text-transform:uppercase}.hg-path-title>span{color:var(--accent)}.hg-path-sub{font-size:12px;line-height:1.4;color:#c9c9c3}@media(max-width:989px){.hg-paths{grid-template-columns:repeat(2,minmax(0,1fr));max-width:640px}}@media(max-width:749px){.hg-paths{gap:8px;margin-bottom:14px}.hg-path{min-height:66px;padding:10px 12px;gap:4px}.hg-path-title{font-size:13px;font-stretch:100%}.hg-path-sub{font-size:10px}.hg-stream[data-mode=home] .hg-billboard{height:auto}}@media(prefers-reduced-motion:reduce){.hg-path{transition:none}}</style>
<nav class="hg-paths" aria-label="{{ 'home_gym.stream.browse' | t }}">{% for i in (1..4) %}{% capture label_key %}path_{{ i }}_label{% endcapture %}{% capture sub_key %}path_{{ i }}_sub{% endcapture %}{% capture view_key %}path_{{ i }}_view{% endcapture %}{% assign label = section.settings[label_key] %}{% if label != blank %}<a class="hg-path" href="{{ routes.root_url }}?view={{ section.settings[view_key] }}&amp;preview_theme_id={{ theme.id }}"><span class="hg-path-title">{{ label | escape }} <span aria-hidden="true">↗</span></span>{% if section.settings[sub_key] != blank %}<span class="hg-path-sub">{{ section.settings[sub_key] | escape }}</span>{% endif %}</a>{% endif %}{% endfor %}</nav>
