{% doc %}
Renders the 9:16 hero video of a Home Gym landing page: small on the right next to the
hero text on desktop, full width without text on mobile. Behaviour in assets/hg-portrait.js.
@param {object} section - Home Gym section with hero_portrait_mp4_url set
{% enddoc %}
<style>.hg-billboard-text{min-width:0}.hg-billboard--portrait .hg-billboard-copy{display:flex;align-items:flex-end;justify-content:space-between;gap:clamp(32px,5vw,96px)}.hg-billboard--portrait .hg-billboard-text{flex:1}.hg-portrait{position:relative;flex:none;width:min(clamp(220px,20vw,320px),calc((max(670px,86vh) - 200px) * .5625));aspect-ratio:9/16;border:1px solid #ffffff2e;border-radius:8px;overflow:hidden;background:#171719;box-shadow:0 24px 60px rgba(0,0,0,.55)}.hg-portrait video{display:block;width:100%;height:100%;object-fit:cover}.hg-portrait-sound{position:absolute;right:12px;bottom:12px;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;border:1px solid #ffffff99;background:#05050688;color:#fff}.hg-portrait-sound:hover{border-color:var(--accent);color:var(--accent)}.hg-portrait-sound svg{width:17px;height:17px}.hg-portrait-sound[aria-pressed=true] .hg-sound-off{display:none}.hg-portrait-sound[aria-pressed=true] .hg-sound-on{display:block}@media(max-width:749px){.hg-billboard--portrait{display:block;margin:0;border:0;border-radius:0;min-height:0;height:auto;max-height:none;padding:0;overflow:visible}.hg-billboard--portrait .hg-backdrop{display:none}.hg-billboard--portrait .hg-billboard-copy{display:block;padding:0}.hg-billboard--portrait .hg-billboard-text>:not(h1){display:none}.hg-billboard--portrait .hg-billboard-text>h1{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.hg-portrait{width:100%;border:0;border-radius:0;box-shadow:none}.hg-portrait-sound{right:16px;bottom:16px}}</style>
<div class="hg-portrait" data-portrait>
<video data-portrait-video autoplay muted loop playsinline preload="metadata" width="416" height="740" disablepictureinpicture disableremoteplayback aria-label="{{ 'home_gym.stream.video_title' | t }}"><source src="{{ section.settings.hero_portrait_mp4_url | escape }}" type="video/mp4"></video>
<button type="button" class="hg-portrait-sound" data-portrait-sound aria-pressed="false" aria-label="{{ 'home_gym.stream.video_unmute' | t }}" data-label-unmute="{{ 'home_gym.stream.video_unmute' | t }}" data-label-mute="{{ 'home_gym.stream.video_mute' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M11 4 5 9H2v6h3l6 5z"/><path class="hg-sound-off" d="m16 9 6 6m0-6-6 6"/><path class="hg-sound-on" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg></button>
</div>
<script src="{{ 'hg-portrait.js' | asset_url }}" defer></script>
