{% doc %}
Renders the 9:16 hero video of a Home Gym landing page: small on the right next to the
hero text on desktop, full width without text on mobile, where a trial-training button
sits on the video. Behaviour in assets/hg-portrait.js.
@param {object} section - Home Gym section with hero_portrait_mp4_url set
{% enddoc %}
<style>.hg-billboard-text{min-width:0}.hg-billboard--portrait .hg-billboard-copy{display:flex;align-items:flex-end;justify-content:space-between;gap:clamp(32px,5vw,96px)}.hg-billboard--portrait .hg-billboard-text{flex:1}.hg-portrait{position:relative;flex:none;width:min(clamp(240px,21vw,340px),calc((max(670px,86vh) - 200px) * .5625));aspect-ratio:9/16;border:1px solid #ffffff2e;border-radius:8px;overflow:hidden;background:#050506;box-shadow:0 24px 60px rgba(0,0,0,.55)}.hg-portrait video{display:block;width:100%;height:100%;object-fit:cover}.hg-portrait-bar{position:absolute;left:12px;right:12px;bottom:12px;display:flex;align-items:center;justify-content:flex-end;gap:8px}.hg-portrait-cta{display:none}.hg-portrait-sound{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:0 14px 0 11px;border-radius:40px;border:1px solid #ffffff99;background:#050506b3;color:#fff;font-size:12px;font-weight:700;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}.hg-portrait-sound:hover{border-color:var(--accent);color:var(--accent)}.hg-portrait-sound svg{width:17px;height:17px}.hg-portrait-sound[aria-pressed=true]{padding:0;width:36px;justify-content:center}.hg-portrait-sound[aria-pressed=true] .hg-portrait-sound-text,.hg-portrait-sound[aria-pressed=true] .hg-sound-off{display:none}.hg-portrait-sound[aria-pressed=true] .hg-sound-on{display:block}@media(max-width:749px){.hg-billboard--portrait{display:block;margin:0;border:0;border-radius:0;min-height:0;height:auto;max-height:none;padding:0;overflow:visible}.hg-billboard--portrait .hg-backdrop{display:none}.hg-billboard--portrait .hg-billboard-copy{display:block;padding:0}.hg-billboard--portrait .hg-billboard-text>:not(h1){display:none}.hg-billboard--portrait .hg-billboard-text>h1{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.hg-portrait{width:100%;border:0;border-radius:0;box-shadow:none}.hg-portrait-bar{left:16px;right:16px;bottom:16px}.hg-portrait-cta{display:inline-flex;flex:1;align-items:center;justify-content:center;gap:8px;min-height:48px;border-radius:4px;background:var(--accent);color:#050506;font-size:14px;font-weight:800}.hg-portrait-sound{min-height:48px;padding:0 14px 0 12px}.hg-portrait-sound[aria-pressed=true]{width:48px}}</style>
{%- liquid
  assign unmute_label = section.settings.portrait_sound_label
  if unmute_label == blank
    assign unmute_label = 'home_gym.stream.video_unmute' | t
  endif
-%}
<div class="hg-portrait" data-portrait>
<video data-portrait-video autoplay muted loop playsinline preload="metadata" width="1080" height="1920" disablepictureinpicture disableremoteplayback aria-label="{{ section.settings.headline | escape }}"><source src="{{ section.settings.hero_portrait_mp4_url | escape }}" type="video/mp4"></video>
<div class="hg-portrait-bar"><a class="hg-portrait-cta" href="#termin">{{ section.settings.cta | escape }} <span aria-hidden="true">↗</span></a><button type="button" class="hg-portrait-sound" data-portrait-sound aria-pressed="false" aria-label="{{ unmute_label | escape }}" data-label-unmute="{{ unmute_label | escape }}" data-label-mute="{{ 'home_gym.stream.video_mute' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M11 4 5 9H2v6h3l6 5z"/><path class="hg-sound-off" d="m16 9 6 6m0-6-6 6"/><path class="hg-sound-on" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg>{% if section.settings.portrait_sound_label != blank %}<span class="hg-portrait-sound-text">{{ section.settings.portrait_sound_label | escape }}</span>{% endif %}</button></div>
</div>
<script src="{{ 'hg-portrait.js' | asset_url }}" defer></script>
