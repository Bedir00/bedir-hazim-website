{% doc %}
Renders the 360° tour dialog of the Home Gym hero. Links with data-tour-open open it;
assets/hg-tour.js loads the Google Maps view only after that click.
@param {object} section - Home Gym section
{% enddoc %}
<style>.hg-hero-actions .hg-tour-entrance svg{width:20px;height:20px;color:var(--accent)}.hg-tour{width:min(1280px,calc(100vw - 48px));height:min(820px,calc(100svh - 48px));max-width:none;max-height:none;margin:auto;padding:0;border:1px solid #2f2f33;border-radius:8px;background:#050506;color:#f2f2ec;overflow:hidden}.hg-tour::backdrop{background:rgba(5,5,6,.84);-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}.hg-tour[open]{display:flex;flex-direction:column}html:has(.hg-tour[open]){overflow:hidden}.hg-tour-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 12px 12px 22px;border-bottom:1px solid #202024}.hg-tour-title{font-size:15px;line-height:1.3;font-weight:900;font-stretch:125%;letter-spacing:-.01em;text-transform:uppercase;min-width:0}.hg-tour-close{flex-shrink:0;display:grid;place-items:center;width:44px;height:44px;border:1px solid #48484c;border-radius:50%;background:#171719}.hg-tour-close:hover{border-color:var(--accent);color:var(--accent)}.hg-tour-close svg{width:20px;height:20px}.hg-tour-frame{position:relative;flex:1;min-height:0;background:#171719}.hg-tour-frame:before{content:"";position:absolute;top:50%;left:50%;width:36px;height:36px;margin:-18px 0 0 -18px;border:3px solid #ffffff2e;border-top-color:var(--accent);border-radius:50%;animation:hg-tour-spin .9s linear infinite}.hg-tour-frame iframe{position:relative;display:block;width:100%;height:100%;border:0}.hg-tour-note{padding:10px 22px 12px;font-size:11px;line-height:1.5;color:#95958f;border-top:1px solid #202024}@keyframes hg-tour-spin{to{transform:rotate(360deg)}}@media(max-width:749px){.hg-tour{width:100vw;height:100svh;border:0;border-radius:0}.hg-tour-head{padding:8px 8px 8px 16px}.hg-tour-title{font-size:13px}.hg-tour-note{padding:8px 16px calc(10px + env(safe-area-inset-bottom,0px));font-size:10px}}@media(prefers-reduced-motion:reduce){.hg-tour-frame:before{animation-duration:3s}}</style>
<dialog class="hg-tour" data-tour-dialog aria-labelledby="hg-tour-title-{{ section.id }}">
<div class="hg-tour-head"><h2 id="hg-tour-title-{{ section.id }}" class="hg-tour-title" data-tour-heading>{{ section.settings.tour_entrance_label | escape }}</h2><button type="button" class="hg-tour-close" data-tour-close aria-label="{{ 'accessibility.close_dialog' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
<div class="hg-tour-frame" data-tour-frame></div>
{% if section.settings.tour_note != blank %}<p class="hg-tour-note">{{ section.settings.tour_note | escape }}</p>{% endif %}
</dialog>
<script src="{{ 'hg-tour.js' | asset_url }}" defer></script>
