<!doctype html>
<html lang="{{ menu.language or 'de' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} – Speisekarte</title>
{% if fonts_url %}<link rel="stylesheet" href="{{ fonts_url }}">{% endif %}
<style>
  :root {
    --primary: {{ c.primary }};
    --secondary: {{ c.secondary }};
    --accent: {{ c.accent }};
    --bg: {{ c.background }};
    --text: {{ c.text }};
    --on-primary: {{ on_primary }};
    --muted: {{ muted }};
    --heading-font: '{{ ci.heading_font }}', Georgia, serif;
    --body-font: '{{ ci.body_font }}', 'Helvetica Neue', Arial, sans-serif;
  }
  @page { size: {{ ci.page_format }}; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--body-font);
    font-size: 10.5pt;
    line-height: 1.45;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  /* clone: Innenabstand wiederholt sich auf jeder gedruckten Seite (randloser Hintergrund bleibt erhalten). */
  .sheet { padding: 16mm; min-height: 100vh; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  header.masthead { text-align: center; margin-bottom: 10mm; }
  header.masthead img.logo { max-height: 28mm; max-width: 70mm; object-fit: contain; display: block; margin: 0 auto 4mm; }
  header.masthead h1 {
    font-family: var(--heading-font); color: var(--primary);
    font-size: 30pt; line-height: 1.1; margin: 0; letter-spacing: .01em;
  }
  header.masthead .tagline { color: var(--muted); margin-top: 2mm; font-size: 11pt; }
  .sections { column-gap: 12mm; }
  .sections.two-col { columns: 2; }
  section.menu-section { margin-bottom: 8mm; }
  section.menu-section h2 {
    font-family: var(--heading-font); color: var(--primary);
    font-size: 16pt; margin: 0 0 1mm; break-after: avoid; break-inside: avoid;
  }
  section.menu-section .note { color: var(--muted); font-size: 9pt; margin: 0 0 3mm; }
  .item { break-inside: avoid; margin: 0 0 3mm; }
  .item .line { display: flex; align-items: baseline; gap: 2mm; }
  .item .name { font-weight: 600; }
  .item .leader { flex: 1; }
  .item .price { font-weight: 600; color: var(--accent); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .item .desc { color: var(--muted); font-size: 9.5pt; margin-top: .5mm; }
  .item sup.allergens { font-size: 6.5pt; color: var(--muted); font-weight: 400; margin-left: .5mm; }
  .item .tags { display: inline-flex; gap: 1mm; margin-left: 1.5mm; vertical-align: middle; }
  .tag {
    font-size: 6.5pt; text-transform: uppercase; letter-spacing: .06em;
    border: .3mm solid var(--secondary); color: var(--primary);
    border-radius: 1mm; padding: .2mm 1.2mm; font-weight: 600;
  }
  .variants { display: flex; flex-wrap: wrap; gap: 1mm 4mm; margin-top: .5mm; font-size: 9.5pt; }
  .variants .price { font-weight: 600; color: var(--accent); }
  footer.notes { margin-top: 6mm; padding-top: 3mm; border-top: .3mm solid var(--secondary); font-size: 8pt; color: var(--muted); }
  footer.notes p { margin: 0 0 1mm; }

  /* ---- Stil: klassisch ---- */
  .style-klassisch section.menu-section h2 { text-align: center; }
  .style-klassisch section.menu-section h2::after {
    content: ""; display: block; width: 18mm; height: .5mm; background: var(--secondary); margin: 1.5mm auto 0;
  }
  .style-klassisch section.menu-section .note { text-align: center; }
  .style-klassisch .item .leader { border-bottom: .3mm dotted var(--secondary); transform: translateY(-1mm); }

  /* ---- Stil: modern ---- */
  .style-modern header.masthead { text-align: left; background: var(--primary); color: var(--on-primary); margin: -16mm -16mm 10mm; padding: 14mm 16mm 10mm; }
  .style-modern header.masthead img.logo { margin: 0 0 4mm; }
  .style-modern header.masthead h1 { color: var(--on-primary); }
  .style-modern header.masthead .tagline { color: var(--on-primary); opacity: .85; }
  .style-modern section.menu-section h2 {
    font-size: 13pt; text-transform: uppercase; letter-spacing: .08em;
    border-left: 1.6mm solid var(--accent); padding-left: 2.5mm; margin-bottom: 3mm;
  }
  .style-modern .item .name { font-weight: 700; }

  /* ---- Stil: minimal ---- */
  .style-minimal header.masthead h1 { font-weight: 400; font-size: 26pt; }
  .style-minimal section.menu-section h2 {
    font-family: var(--body-font); font-size: 9pt; text-transform: uppercase; letter-spacing: .2em;
    color: var(--text); border-bottom: .3mm solid var(--text); padding-bottom: 1mm; margin-bottom: 3mm;
  }
  .style-minimal .item .name { font-weight: 500; }
  .style-minimal .item .price { color: var(--text); font-weight: 500; }

  /* ---- Web-Ansicht ---- */
  .mode-web .sheet { max-width: 820px; margin: 0 auto; padding: 32px 20px 48px; min-height: 0; }
  body.mode-web { font-size: 16px; }
  body.mode-web.style-modern header.masthead { margin: -32px -20px 28px; padding: 36px 20px 24px; }
  .mode-web nav.jump {
    position: sticky; top: 0; z-index: 2; background: var(--bg);
    display: flex; gap: 8px; overflow-x: auto; padding: 10px 0; margin-bottom: 20px;
    border-bottom: 1px solid var(--secondary);
  }
  .mode-web nav.jump a {
    flex: none; text-decoration: none; color: var(--primary); font-weight: 600; font-size: 14px;
    border: 1px solid var(--secondary); border-radius: 999px; padding: 4px 12px;
  }
  .mode-web .sections.two-col { columns: 2; }
  @media (max-width: 680px) { .mode-web .sections.two-col { columns: 1; } .mode-web header.masthead h1 { font-size: 30px; } }
  .mode-print nav.jump { display: none; }
</style>
</head>
<body class="mode-{{ mode }} style-{{ ci.layout_style }}">
<div class="sheet">
  <header class="masthead">
    {% if logo_data_uri %}<img class="logo" src="{{ logo_data_uri }}" alt="{{ title }} Logo">{% endif %}
    {% if not logo_data_uri or show_name_with_logo %}<h1>{{ title }}</h1>{% endif %}
    {% if ci.tagline %}<div class="tagline">{{ ci.tagline }}</div>{% endif %}
  </header>

  {% if mode == 'web' and menu.sections|length > 1 %}
  <nav class="jump">
    {% for section in menu.sections %}<a href="#s{{ loop.index }}">{{ section.title }}</a>{% endfor %}
  </nav>
  {% endif %}

  <div class="sections{% if two_columns %} two-col{% endif %}">
    {% for section in menu.sections %}
    <section class="menu-section" id="s{{ loop.index }}">
      <h2>{{ section.title }}</h2>
      {% if section.note %}<p class="note">{{ section.note }}</p>{% endif %}
      {% for item in section.entries %}
      <div class="item">
        <div class="line">
          <span class="name">{{ item.name }}{% if item.allergens %}<sup class="allergens">{{ item.allergens|join(',') }}</sup>{% endif %}{% if item.tags %}<span class="tags">{% for tag in item.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</span>{% endif %}</span>
          {% if item.display_price %}<span class="leader"></span><span class="price">{{ item.display_price }}</span>{% endif %}
        </div>
        {% if item.description %}<div class="desc">{{ item.description }}</div>{% endif %}
        {% if item.display_variants %}
        <div class="variants">{% for v in item.display_variants %}<span>{{ v.label }} <span class="price">{{ v.price }}</span></span>{% endfor %}</div>
        {% endif %}
      </div>
      {% endfor %}
    </section>
    {% endfor %}
  </div>

  {% if footer_notes %}
  <footer class="notes">
    {% for note in footer_notes %}<p>{{ note }}</p>{% endfor %}
  </footer>
  {% endif %}
</div>
</body>
</html>
